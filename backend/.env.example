# Shape required by Telegram / aiogram: <bot_id>:<35-char token>, e.g.
# 123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=
WEBHOOK_SECRET=
TEACHER_TELEGRAM_ID=
BASE_URL=https://api.domain.uz
MINIAPP_URL=https://journal.vercel.app
JWT_SECRET=
DATABASE_URL=sqlite+aiosqlite:///./data/journal.db
ELEVENLABS_API_KEY=
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# webhook (production) or polling (local dev without a public HTTPS host).
# Explicit, because inferring it from the shape of BASE_URL silently picked
# the wrong mode for any hostname that resembled the placeholder below.
BOT_MODE=webhook

# auto infers the provider from the key prefix / model name. Pin it to make
# the choice explicit -- "auto" is why a deployment could silently be talking
# to a different provider than .env said.
LLM_PROVIDER=auto
ASR_PROVIDER=auto
