# Copy to .env at the repository root before `docker compose up`.
# docker compose reads this file and injects the values as environment
# variables into the app container; nothing here is ever copied into an image.

# From @BotFather. Shape required by Telegram / aiogram:
# <bot_id>:<35-char token>, e.g. 123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=

# Shared secret in the webhook path AND checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Numeric Telegram id of the single teacher. Every /api/* route rejects
# anyone else. Find it by messaging @userinfobot.
TEACHER_TELEGRAM_ID=

# Public HTTPS origin of this backend; the webhook is registered under it.
# Must match the hostname in the Caddyfile.
BASE_URL=https://api.domain.uz

# Origin the Mini App is served from. Becomes the allowed CORS origin, so a
# wrong value here makes every request from the Mini App fail in the browser.
MINIAPP_URL=https://journal.vercel.app

# Signs the 30-minute Mini App session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Relative to the container WORKDIR (/app), so this resolves inside the
# ./data bind mount declared in docker-compose.yml.
DATABASE_URL=sqlite+aiosqlite:///./data/journal.db

ELEVENLABS_API_KEY=
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# webhook (production) or polling (local dev).
#
# Telegram only delivers updates to a public HTTPS URL. On a laptop there is
# no such hostname, so local development MUST set BOT_MODE=polling -- with
# webhook the bot registers an address that can never fire and /start simply
# gets no reply. The app refuses to start in that combination rather than
# leaving you to guess.
BOT_MODE=webhook

# auto infers the provider from the key prefix / model name. Pin it to make
# the choice explicit -- "auto" is why a deployment could silently be talking
# to a different provider than .env said.
LLM_PROVIDER=auto
ASR_PROVIDER=auto
